{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.4-mini",
  "agent": {
    "build": { "mode": "primary", "variant": "medium", "steps": 20, "permission": { "task": { "*": "deny", "verifier": "ask" } } }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 4
  },
  "tool_output": { "max_lines": 120, "max_bytes": 8192 },
  "permission": {
    "review_mode_get": "allow",
    "review_status": "allow",
    "review_validate": "allow",
    "review_mode_set": "ask",
    "review_start": "ask",
    "review_capture": "ask",
    "review_verify": "ask",
    "review_finalize": "ask",
    "review_gate": "ask"
  },
  "plugin": [
    "__HOME__/.config/opencode/plugins-optional/personalities.js",
    "__HOME__/.config/opencode/plugins/guardrails.js",
    "__HOME__/.config/opencode/plugins/checkpoints.js",
    "__HOME__/.config/opencode/plugins/validator.js",
    "__HOME__/.config/opencode/plugins/session-metrics.js",
    "__HOME__/.config/opencode/plugins/organic-rdd.js"
  ]
}
