{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "agent": {
    "build": { "mode": "primary", "variant": "high", "steps": 48 }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 6
  },
  "tool_output": { "max_lines": 200, "max_bytes": 8192 },
  "permission": {
    "review_mode_get": "allow",
    "review_status": "allow",
    "review_validate": "allow",
    "review_mode_set": "ask",
    "review_start": "ask",
    "review_capture": "ask",
    "review_verify": "ask",
    "review_finalize": "ask",
    "review_gate": "ask"
  },
  "plugin": [
    "__HOME__/.config/opencode/plugins-optional/personalities.js",
    "__HOME__/.config/opencode/plugins/guardrails.js",
    "__HOME__/.config/opencode/plugins/checkpoints.js",
    "__HOME__/.config/opencode/plugins-optional/kanban.js",
    "__HOME__/.config/opencode/plugins-optional/sandbox.js",
    "__HOME__/.config/opencode/plugins/validator.js",
    "__HOME__/.config/opencode/plugins/session-metrics.js",
    "__HOME__/.config/opencode/plugins-optional/auto-memory.js",
    "__HOME__/.config/opencode/plugins/organic-rdd.js"
  ],
  "mcp": {
    "memory-adapter": {
      "type": "local",
      "command": ["node", "__HOME__/.config/opencode/mcp/memory-adapter/src/mcp-server.js"],
      "enabled": true,
      "timeout": 30000
    },
    "local-model-router": {
      "type": "local",
      "command": ["node", "__HOME__/.config/opencode/mcp/local-model-router.js"],
      "enabled": true,
      "timeout": 150000
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp@3.2.4"],
      "enabled": true
    },
    "diagram-generator": {
      "type": "local",
      "command": ["npx", "-y", "mcp-diagram-generator@1.2.0"],
      "enabled": true
    }
  }
}
